MENU = [
    ("1", "add a provider trunk", trunk_add),
    ("2", "list configured trunks", trunk_list),
    ("3", "remove a trunk", lambda: trunk_remove(None)),
    ("4", "configure the HA_IVR link", haivr_set),
    ("5", "test the HA_IVR link", lambda: haivr_test(
        ask("caller number to test as (blank = placeholder)", required=False))),
    ("6", "show the alert secret", show_secret),
    ("7", "system status", status),
]


def menu_loop() -> None:
    while True:
        title("PBX management")
        for key, label, _ in MENU:
            print(f"    {key}) {label}")
        print("    0) quit")
        choice = input("\nchoose: ").strip()
        if choice in ("0", "q", ""):
            return
        for key, _, action in MENU:
            if choice == key:
                try:
                    action()
                except SystemExit:
                    pass
                except KeyboardInterrupt:
                    note("\naborted.")
                pause()
                break
        else:
            note("no such choice")


def usage() -> None:
    print(__doc__.strip().splitlines()[0])
    print("""
usage:
  sudo ./pbx                      interactive menu
  sudo ./pbx trunk add|list|remove
  sudo ./pbx haivr set|show|test [number]
  sudo ./pbx secret               reveal the alert secret for HA
  sudo ./pbx status               full health check
  sudo ./pbx install [--force]    build and configure this box
""")


def main() -> None:
    args = sys.argv[1:]
    # Help must work for anyone: needing sudo just to read the usage is a
    # pointless wall, and it is the first thing a stuck operator tries.
    if args and args[0] in ("-h", "--help", "help"):
        usage()
        return
    require_root()
    if not args:
        menu_loop()
        return

    group, rest = args[0], args[1:]
    sub = rest[0] if rest else ""

    if group == "trunk":
        {"add": trunk_add, "list": trunk_list,
         "remove": lambda: trunk_remove(rest[1] if len(rest) > 1 else None),
         "": trunk_add}.get(sub, usage)()
    elif group == "haivr":
        {"set": haivr_set, "show": haivr_show,
         "test": lambda: haivr_test(rest[1] if len(rest) > 1 else ""),
         "": haivr_set}.get(sub, usage)()
    elif group == "secret":
        show_secret()
    elif group == "status":
        status()
    elif group == "install":
        run_install([a for a in rest if a == "--force"])
    else:
        usage()
        sys.exit(2)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\naborted.")
        sys.exit(130)
