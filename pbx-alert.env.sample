# /etc/pbx-alert.env  — mode 600, root:root
# The real secret is set ONLY on the box, never committed here.
# It MUST be byte-for-byte identical to the "alert service secret" field in the
# Home Assistant ha_ivr record, or every POST comes back 403.
PBX_ALERT_SECRET=REPLACE_WITH_SHARED_SECRET
PBX_ALERT_PORT=5000
# Caller ID for alert calls when the producer does not send one. A bare number
# is auto-bracketed by call_trigger.py; leaving it empty falls back to
# <0000000000>. Producers can still override per call ("caller_id" field).
PBX_ALERT_CALLERID=
